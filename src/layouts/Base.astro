---
import { languages, type Language } from '../lib/posts';
import { siteConfig, hasFaq } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang: Language;
  alternatives?: { lang: Language; url: string }[];
  activeNav?: 'posts' | 'archive' | 'search' | 'tags' | 'about' | 'faq';
}
const { title, description, lang, alternatives = [], activeNav } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const labels = lang === 'it'
  ? { posts: 'Articoli', archive: 'Archivio', search: 'Cerca', tags: 'Tags', about: 'Chi siamo', faq: 'FAQ', nav: 'Navigazione principale', languages: 'Lingua', skip: 'Vai al contenuto', theme: 'Tema scuro' }
  : { posts: 'Posts', archive: 'Archive', search: 'Search', tags: 'Tags', about: 'About us', faq: 'FAQ', nav: 'Main navigation', languages: 'Language', skip: 'Skip to content', theme: 'Dark theme' };
const navigation = [
  { key: 'posts', url: `/${lang}/` },
  { key: 'archive', url: `/${lang}/archive/` },
  { key: 'search', url: `/${lang}/search/` },
  { key: 'tags', url: `/${lang}/tags/` },
  { key: 'about', url: `/${lang}/about/` },
  ...(hasFaq(lang) ? [{ key: 'faq', url: `/${lang}/faq/` }] : []),
] as { key: keyof typeof labels; url: string }[];
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} | {siteConfig.name}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_US'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    {alternatives.map((item) => <link rel="alternate" hreflang={item.lang} href={new URL(item.url, Astro.site)} />)}
    <script is:inline>
      (() => {
        let theme;
        try { theme = localStorage.getItem('code-geeks-theme'); } catch {}
        document.documentElement.dataset.theme = theme === 'dark' || theme === 'light'
          ? theme : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{labels.skip}</a>
    <header class="site-header">
      <div class="header-inner">
        <div class="brand-tools">
          <a class="brand" href={`/${lang}/`}>{siteConfig.name}<span class="brand-dot" aria-hidden="true">.</span></a>
          <button id="theme-toggle" class="theme-toggle" type="button" aria-label={labels.theme} aria-pressed="false" hidden>
            <svg class="moon-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.7 13.1A9 9 0 0 1 10.9 3.3 9 9 0 1 0 20.7 13.1Z" /></svg>
            <svg class="sun-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" /></svg>
          </button>
        </div>
        <nav class="main-nav" aria-label={labels.nav}>
          {navigation.map((item) => <a href={item.url} aria-current={activeNav === item.key ? (Astro.url.pathname === item.url ? 'page' : 'true') : undefined}>{labels[item.key]}</a>)}
        </nav>
        <nav class="language-nav" aria-label={labels.languages}>
          {languages.map((language) => {
            const translation = alternatives.find((item) => item.lang === language);
            const url = translation?.url ?? `/${language}/`;
            const name = language === 'it' ? 'Italiano' : 'English';
            return <a href={url} lang={language} hreflang={language} aria-label={name}
              title={translation ? name : `${name} · ${language === 'it' ? 'Pagina iniziale' : 'Home page'}`}
              aria-current={language === lang ? 'true' : undefined}>{language.toUpperCase()}</a>;
          })}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} <a href={`/${lang}/`}>{siteConfig.name}</a></span>
      <span>Italiano / English</span>
    </footer>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>('#theme-toggle');
      if (toggle) {
        toggle.hidden = false;
        const syncToggle = () => toggle.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
        syncToggle();
        toggle.addEventListener('click', () => {
          const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = theme;
          try { localStorage.setItem('code-geeks-theme', theme); } catch {}
          syncToggle();
        });
      }
    </script>
  </body>
</html>
